# Student Power / ATI UAF — Environment Variables Example
# Duplicate this file to .env.local and replace the placeholders

# Application Base URL
NEXT_PUBLIC_SITE_URL=https://atiuaf.com

# Contact & Notifications
CONTACT_RECEIVER_EMAIL=atiuaf1968@gmail.com
SECRETARIAT_HELPLINE=+923172011968

# Mailtrap Live SMTP Credentials
# Get your token from: https://mailtrap.io/api-smtp/sending-setup -> Live Sending -> SMTP
MAILTRAP_SMTP_HOST=live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=api
MAILTRAP_SMTP_PASS=<YOUR_API_TOKEN>

# Default Sender & Test Recipient
# The sender domain must be verified on Mailtrap (e.g., atiuaf.com)
MAIL_FROM="Private Person <hello@atiuaf.com>"
MAIL_TO="A Test User <atiuaf1968@gmail.com>"

# Persistent Storage for Resumes (Optional for Vercel Blob / S3)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=student-power-resumes
# AWS_REGION=ap-southeast-1
